default_platform(:android)

platform :android do
  desc "Upload the signed Android App Bundle and store listing to Google Play"
  lane :deploy do |options|
    aab = options[:aab] || "build/app/outputs/bundle/release/app-release.aab"
    track = options[:track] || "production"
    metadata(track: track)
    upload_to_play_store(
      aab: aab,
      track: track,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload only the Play Store listing, including generated screenshots"
  lane :metadata do |options|
    upload_to_play_store(
      track: options[:track] || "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end
